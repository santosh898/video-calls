rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile matching & discovery (keyed by phone number for zero duplicates & auto-merging)
    match /users/{userPhone} {
      allow read, write: if request.auth != null;
    }
    
    // Groups
    match /groups/{groupId} {
      allow read, write: if request.auth != null;
    }
    
    // Call signaling & rooms
    match /calls/{callId} {
      allow read, write: if request.auth != null;
      
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
